# Solo nombres. Los valores viven en AWS Secrets Manager (nunca en .env, codigo ni logs).
# scripts/push-secrets.sh carga los SECRET_* de abajo (llaves de GCP, despues del deploy de AWS).
# fleetpulse/api/ingest-key y fleetpulse/api/console-key NO van aqui: las genera el stack fp-core
# (CloudFormation, aws/ingest/serverless.yml) y ese es su unico dueno.
SECRET_GCP_SA_EXPORTER=fleetpulse/gcp/sa-exporter
SECRET_GCP_SA_INVOKER=fleetpulse/gcp/sa-invoker
# GCP Secret Manager (lo lee Cloud Run, no AWS)
GCP_SECRET_GEMINI=gemini-api-key
GCP_SECRET_AWS_CONSOLE_KEY=aws-console-api-key
# Perillas del simulador (SSM Parameter Store)
SSM_SIM_SCENARIOS=/fleetpulse/sim/scenarios
# Proyecto GCP (creado sab 14/11 22:05; facturacion = Free Trial; region us-east1)
GCP_PROJECT_ID=fleetpulse-g19-2026
GCP_PROJECT_NUMBER=603826680958
GCP_REGION=us-east1
# FP_TEST_PASSWORD: solo en el entorno de quien corre scripts/cognito-seed.sh
