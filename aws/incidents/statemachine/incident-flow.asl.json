{
  "Comment": "incident-flow (T09 + T14): clasifica; si la maquina ya tiene un incidente abierto lo escala (y avisa a supervisor, direccion y al operador si sube la severidad) y termina; si no, correlaciona por celda y zona, crea el incidente, pide la explicacion a Cloud Run (plantilla si falla), rankea, espera la aprobacion del supervisor si la severidad es schedule (30 min, luego asignacion automatica), asigna (termina si el incidente ya se cerro), arma los textos con el tecnico asignado, notifica por rol y pide la reserva de repuestos. CorrelateZone, ExplainCause y WaitForApproval degradan en vez de fallar.",
  "StartAt": "ClassifySeverity",
  "States": {
    "ClassifySeverity": {
      "Type": "Task",
      "Resource": "${ClassifyArn}",
      "ResultPath": "$.classified",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PublishAlert"
        }
      ],
      "Next": "CheckExistingIncident"
    },
    "CheckExistingIncident": {
      "Type": "Task",
      "Resource": "${CheckExistingArn}",
      "ResultPath": "$.existing",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PublishAlert"
        }
      ],
      "Next": "AlreadyOpen?"
    },
    "AlreadyOpen?": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.existing.found",
          "BooleanEquals": true,
          "Next": "Escalated?"
        }
      ],
      "Default": "CorrelateZone"
    },
    "Escalated?": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.existing.escalated",
          "BooleanEquals": true,
          "Next": "NotifyEscalation"
        }
      ],
      "Default": "EscalatedOrIgnored"
    },
    "NotifyEscalation": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "NotifyEscalationSupervisor",
          "States": {
            "NotifyEscalationSupervisor": {
              "Type": "Task",
              "Resource": "arn:aws:states:::sns:publish",
              "Parameters": {
                "TopicArn": "${NotifyTopicArn}",
                "Subject.$": "States.Format('[FleetPulse] escalado {} {}', $.machine_id, $.existing.incident_id)",
                "Message.$": "States.Format('El incidente {} de la maquina {} (zona {}) subio de severidad {} a {} con score {}. Si aun espera aprobacion, el supervisor puede aprobarlo ya desde el correo anterior; revisar asignacion y repuestos en la consola.', $.existing.incident_id, $.machine_id, $.zone_id, $.existing.from_severity, $.existing.to_severity, $.existing.score)",
                "MessageAttributes": {
                  "role": {
                    "DataType": "String",
                    "StringValue": "supervisor"
                  }
                }
              },
              "Retry": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 3,
                  "BackoffRate": 2
                }
              ],
              "End": true
            }
          }
        },
        {
          "StartAt": "NotifyEscalationManagement",
          "States": {
            "NotifyEscalationManagement": {
              "Type": "Task",
              "Resource": "arn:aws:states:::sns:publish",
              "Parameters": {
                "TopicArn": "${NotifyTopicArn}",
                "Subject.$": "States.Format('[FleetPulse] escalado {} {}', $.machine_id, $.existing.incident_id)",
                "Message.$": "States.Format('El incidente {} de la maquina {} (zona {}) subio de severidad {} a {} con score {}. Si aun espera aprobacion, el supervisor puede aprobarlo ya desde el correo anterior; revisar asignacion y repuestos en la consola.', $.existing.incident_id, $.machine_id, $.zone_id, $.existing.from_severity, $.existing.to_severity, $.existing.score)",
                "MessageAttributes": {
                  "role": {
                    "DataType": "String",
                    "StringValue": "management"
                  }
                }
              },
              "Retry": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 3,
                  "BackoffRate": 2
                }
              ],
              "End": true
            }
          }
        },
        {
          "StartAt": "NotifyEscalationOperator",
          "States": {
            "NotifyEscalationOperator": {
              "Type": "Task",
              "Resource": "arn:aws:states:::sns:publish",
              "Parameters": {
                "TopicArn": "${NotifyTopicArn}",
                "Subject.$": "States.Format('[FleetPulse] escalado {} {}', $.machine_id, $.existing.incident_id)",
                "Message.$": "$.existing.operator_message",
                "MessageAttributes": {
                  "role": {
                    "DataType": "String",
                    "StringValue": "operator"
                  }
                }
              },
              "Retry": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 3,
                  "BackoffRate": 2
                }
              ],
              "End": true
            }
          }
        }
      ],
      "ResultSelector": {
        "published": true
      },
      "ResultPath": "$.escalation_notified",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PublishAlert"
        }
      ],
      "Next": "EscalatedOrIgnored"
    },
    "EscalatedOrIgnored": {
      "Type": "Succeed"
    },
    "CorrelateZone": {
      "Type": "Task",
      "Resource": "${CorrelateZoneArn}",
      "ResultPath": "$.correlation",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.correlation_error",
          "Next": "CreateIncident"
        }
      ],
      "Next": "CreateIncident"
    },
    "CreateIncident": {
      "Type": "Task",
      "Resource": "${CreateIncidentArn}",
      "ResultPath": "$.incident",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PublishAlert"
        }
      ],
      "Next": "ExplainCause"
    },
    "ExplainCause": {
      "Type": "Task",
      "Resource": "${ExplainCauseArn}",
      "ResultPath": "$.explanation",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.explain_error",
          "Next": "RankTechnicians"
        }
      ],
      "Next": "RankTechnicians"
    },
    "RankTechnicians": {
      "Type": "Task",
      "Resource": "${RankTechniciansArn}",
      "ResultPath": "$.ranking",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PublishAlert"
        }
      ],
      "Next": "NeedsApproval"
    },
    "NeedsApproval": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.classified.needs_approval",
          "BooleanEquals": true,
          "Next": "WaitForApproval"
        }
      ],
      "Default": "AssignTechnician"
    },
    "WaitForApproval": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${WaitForApprovalArn}",
        "Payload": {
          "input.$": "$",
          "token.$": "$$.Task.Token"
        }
      },
      "TimeoutSeconds": 1800,
      "ResultPath": "$.approval",
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.Timeout"
          ],
          "ResultPath": "$.approval_timeout",
          "Next": "ApprovalTimedOut"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.approval_error",
          "Next": "ApprovalUnavailable"
        }
      ],
      "Next": "AssignTechnician"
    },
    "ApprovalTimedOut": {
      "Type": "Pass",
      "Result": {
        "approval": "timeout"
      },
      "ResultPath": "$.approval",
      "Next": "AssignTechnician"
    },
    "ApprovalUnavailable": {
      "Type": "Pass",
      "Result": {
        "approval": "auto"
      },
      "ResultPath": "$.approval",
      "Next": "AssignTechnician"
    },
    "AssignTechnician": {
      "Type": "Task",
      "Resource": "${AssignTechnicianArn}",
      "ResultPath": "$.assignment",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PublishAlert"
        }
      ],
      "Next": "IncidentClosed?"
    },
    "IncidentClosed?": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.assignment.skipped",
          "IsPresent": true,
          "Next": "Done"
        }
      ],
      "Default": "RenderMessages"
    },
    "RenderMessages": {
      "Type": "Task",
      "Resource": "${RenderMessagesArn}",
      "ResultPath": "$.messages",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PublishAlert"
        }
      ],
      "Next": "NotifyByRole"
    },
    "NotifyByRole": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "NotifyTechnician",
          "States": {
            "NotifyTechnician": {
              "Type": "Task",
              "Resource": "arn:aws:states:::sns:publish",
              "Parameters": {
                "TopicArn": "${NotifyTopicArn}",
                "Subject.$": "$.messages.subject",
                "Message.$": "$.messages.technician",
                "MessageAttributes": {
                  "role": {
                    "DataType": "String",
                    "StringValue": "technician"
                  }
                }
              },
              "Retry": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 3,
                  "BackoffRate": 2
                }
              ],
              "End": true
            }
          }
        },
        {
          "StartAt": "NotifySupervisor",
          "States": {
            "NotifySupervisor": {
              "Type": "Task",
              "Resource": "arn:aws:states:::sns:publish",
              "Parameters": {
                "TopicArn": "${NotifyTopicArn}",
                "Subject.$": "$.messages.subject",
                "Message.$": "$.messages.supervisor",
                "MessageAttributes": {
                  "role": {
                    "DataType": "String",
                    "StringValue": "supervisor"
                  }
                }
              },
              "Retry": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 3,
                  "BackoffRate": 2
                }
              ],
              "End": true
            }
          }
        },
        {
          "StartAt": "ManagementNeeded?",
          "States": {
            "ManagementNeeded?": {
              "Type": "Choice",
              "Choices": [
                {
                  "Or": [
                    {
                      "Variable": "$.assignment.severity",
                      "StringEquals": "immediate"
                    },
                    {
                      "And": [
                        {
                          "Variable": "$.incident.group_id",
                          "IsPresent": true
                        },
                        {
                          "Variable": "$.incident.group_id",
                          "IsNull": false
                        }
                      ]
                    }
                  ],
                  "Next": "NotifyManagement"
                }
              ],
              "Default": "SkipManagement"
            },
            "NotifyManagement": {
              "Type": "Task",
              "Resource": "arn:aws:states:::sns:publish",
              "Parameters": {
                "TopicArn": "${NotifyTopicArn}",
                "Subject.$": "$.messages.subject",
                "Message.$": "$.messages.management",
                "MessageAttributes": {
                  "role": {
                    "DataType": "String",
                    "StringValue": "management"
                  }
                }
              },
              "Retry": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 3,
                  "BackoffRate": 2
                }
              ],
              "End": true
            },
            "SkipManagement": {
              "Type": "Pass",
              "End": true
            }
          }
        },
        {
          "StartAt": "NotifyOperator",
          "States": {
            "NotifyOperator": {
              "Type": "Task",
              "Resource": "arn:aws:states:::sns:publish",
              "Parameters": {
                "TopicArn": "${NotifyTopicArn}",
                "Subject.$": "$.messages.subject",
                "Message.$": "$.messages.operator",
                "MessageAttributes": {
                  "role": {
                    "DataType": "String",
                    "StringValue": "operator"
                  }
                }
              },
              "Retry": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 3,
                  "BackoffRate": 2
                }
              ],
              "End": true
            }
          }
        }
      ],
      "ResultSelector": {
        "published": true
      },
      "ResultPath": "$.notified",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PublishAlert"
        }
      ],
      "Next": "ReserveParts"
    },
    "ReserveParts": {
      "Type": "Task",
      "Resource": "${ReservePartsArn}",
      "ResultPath": "$.reservation",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PublishAlert"
        }
      ],
      "Next": "Done"
    },
    "Done": {
      "Type": "Succeed"
    },
    "PublishAlert": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${AlertsTopicArn}",
        "Subject.$": "States.Format('[FleetPulse] incident-flow fallo {}', $$.Execution.Name)",
        "Message.$": "States.Format('incident-flow {} fallo: {} - {}', $$.Execution.Name, $.Error, $.Cause)"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Failed"
    },
    "Failed": {
      "Type": "Fail",
      "Error": "IncidentFlowFailed",
      "Cause": "Ver el mensaje en fp-alerts y el historial de la ejecucion"
    }
  }
}
