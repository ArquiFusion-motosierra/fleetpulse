{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleetpulse.arquifusion/contracts/machine.snapshot.schema.json",
  "title": "Machine snapshot",
  "description": "Cuerpo de ORDS POST fleet/v1/machines/snapshot. snapshot-publisher lo envia cada 2 minutos con las maquinas que cambiaron de estado o posicion desde el envio anterior. No pasa por el outbox: es estado, no un evento; el ultimo gana por updated_at.",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshot_id", "generated_at", "machines"],
  "properties": {
    "snapshot_id": {"type": "string", "pattern": "^SNP-[0-9]{8}T[0-9]{6}Z$"},
    "generated_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "machines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["machine_id", "status", "severity", "lat", "lon", "zone_id", "hours_total", "updated_at"],
        "properties": {
          "machine_id": {"type": "string", "pattern": "^(EX|CF|VQ|MN|TO)-[0-9]{3}$"},
          "status": {"enum": ["operating", "idle", "off", "in_maintenance"]},
          "severity": {"enum": ["ok", "observe", "schedule", "immediate"], "description": "Color del mapa: verde, amarillo, naranja, rojo."},
          "score": {"type": "number", "minimum": 0},
          "lat": {"type": "number"},
          "lon": {"type": "number"},
          "zone_id": {"enum": ["NORTE", "CENTRO", "SUR"]},
          "hours_total": {"type": "number", "minimum": 0},
          "fuel_remaining_ratio": {"type": "number", "minimum": 0, "maximum": 1},
          "open_incident_id": {"type": ["string", "null"], "pattern": "^INC-(EX|CF|VQ|MN|TO)-[0-9]{3}-[0-9]{8}T[0-9]{4}$"},
          "updated_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
