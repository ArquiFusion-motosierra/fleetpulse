{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleetpulse.arquifusion/contracts/oem_specs.schema.json",
  "title": "OEM specs catalog",
  "description": "Forma de contracts/oem_specs.yaml (T26): ficha tecnica ilustrativa por modelo. La validan los tests del simulador.",
  "type": "object",
  "additionalProperties": false,
  "required": ["illustrative", "version", "resonance_tolerance_pct", "models"],
  "properties": {
    "illustrative": {"const": true},
    "version": {"const": 1},
    "resonance_tolerance_pct": {"type": "number", "exclusiveMinimum": 0, "maximum": 10},
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": ["EX", "CF", "VQ", "MN", "TO", "TA", "CS", "MC", "CP", "GE"],
      "properties": {
        "EX": {"$ref": "#/$defs/model"}, "CF": {"$ref": "#/$defs/model"}, "VQ": {"$ref": "#/$defs/model"},
        "MN": {"$ref": "#/$defs/model"}, "TO": {"$ref": "#/$defs/model"},
        "TA": {"$ref": "#/$defs/model"}, "CS": {"$ref": "#/$defs/model"}, "MC": {"$ref": "#/$defs/model"},
        "CP": {"$ref": "#/$defs/model"}, "GE": {"$ref": "#/$defs/model"}
      }
    }
  },
  "$defs": {
    "range": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
    "upper": {
      "type": "object", "additionalProperties": false, "required": ["normal", "warning", "critical"],
      "properties": {"normal": {"$ref": "#/$defs/range"}, "warning": {"type": "number"}, "critical": {"type": "number"}}
    },
    "lower": {
      "type": "object", "additionalProperties": false, "required": ["normal", "low_warning", "low_critical"],
      "properties": {"normal": {"$ref": "#/$defs/range"}, "low_warning": {"type": "number"}, "low_critical": {"type": "number"}}
    },
    "part": {
      "type": "object", "additionalProperties": false, "required": ["part_id", "qty"],
      "properties": {"part_id": {"type": "string", "pattern": "^PRT-[0-9]{2}$"}, "qty": {"type": "integer", "minimum": 1}}
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "rated_rpm", "idle_rpm", "max_rpm", "rated_fuel_lph", "limits", "service_schedule", "vibration", "typical_failures"],
      "properties": {
        "name": {"type": "string"},
        "rated_rpm": {"type": "number"}, "idle_rpm": {"type": "number"}, "max_rpm": {"type": "number"},
        "rated_fuel_lph": {"type": "number"},
        "limits": {
          "type": "object", "additionalProperties": false,
          "required": ["coolant_temp_c", "hydraulic_oil_temp_c", "hydraulic_pressure_bar", "vibration_mm_s", "fuel_rate_lph"],
          "properties": {
            "coolant_temp_c": {"$ref": "#/$defs/upper"}, "hydraulic_oil_temp_c": {"$ref": "#/$defs/upper"},
            "hydraulic_pressure_bar": {"$ref": "#/$defs/lower"}, "vibration_mm_s": {"$ref": "#/$defs/upper"},
            "fuel_rate_lph": {"$ref": "#/$defs/upper"}
          }
        },
        "service_schedule": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["every_h", "task", "parts"],
            "properties": {"every_h": {"type": "integer", "minimum": 50}, "task": {"type": "string"}, "parts": {"type": "array", "items": {"$ref": "#/$defs/part"}}}
          }
        },
        "vibration": {
          "type": "object", "additionalProperties": false,
          "required": ["pump_vane_order", "gear_mesh_order", "bearing_bpfo_order", "bearing_bpfi_order", "natural_frequencies"],
          "properties": {
            "pump_vane_order": {"type": "number"}, "gear_mesh_order": {"type": "number"},
            "bearing_bpfo_order": {"type": "number"}, "bearing_bpfi_order": {"type": "number"},
            "natural_frequencies": {
              "type": "array", "minItems": 1,
              "items": {
                "type": "object", "additionalProperties": false, "required": ["mode", "component", "hz"],
                "properties": {"mode": {"type": "integer", "minimum": 1}, "component": {"type": "string"}, "hz": {"type": "number", "exclusiveMinimum": 0}}
              }
            }
          }
        },
        "typical_failures": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["failure_mode", "name", "symptoms", "spectrum", "fault_codes", "action"],
            "properties": {
              "failure_mode": {"enum": ["head_gasket", "hydraulic_pump", "hydraulic_contamination", "hydraulic_overheat", "fuel_contamination", "engine_overheat", "final_drive", "brake_wear", "electrical_fault", "sensor_fault"]},
              "name": {"type": "string"},
              "symptoms": {
                "type": "array", "minItems": 1,
                "items": {
                  "type": "object", "additionalProperties": false, "required": ["var", "change"],
                  "properties": {
                    "var": {"enum": ["coolant_temp_c", "hydraulic_oil_temp_c", "hydraulic_pressure_bar", "vibration_mm_s", "engine_rpm", "fuel_rate_lph", "speed_kmh"]},
                    "change": {"enum": ["up", "down", "unstable"]}
                  }
                }
              },
              "spectrum": {"type": "string"},
              "fault_codes": {"type": "array", "items": {"type": "integer", "minimum": 0}},
              "action": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
