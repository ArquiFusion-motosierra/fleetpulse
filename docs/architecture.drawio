gn=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.step_functions;fillColor=#E7157B;" vertex="1" parent="1"><mxGeometry x="600" y="490" width="56" height="56" as="geometry"/></mxCell><mxCell id="c29" value="SSM Parameter Store&lt;br&gt;/fleetpulse/sim/scenarios&lt;br&gt;(perillas S1–S6)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.systems_manager;fillColor=#E7157B;" vertex="1" parent="1"><mxGeometry x="940" y="490" width="56" height="56" as="geometry"/></mxCell><mxCell id="c30" value="Lambda oci-writer&lt;br&gt;OAuth2 · token cacheado 50 min" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;fillColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="1480" y="490" width="56" height="56" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Persistencia, HA y observabilidad&lt;/b&gt;&lt;br&gt;DynamoDB: 3 AZ, PITR 35 d, deletion protection&lt;br&gt;S3: 11 nueves, versionado = fuente de reproceso&lt;br&gt;SQS multi-AZ, DLQ 14 d · SFN: backoff, Catch → fp-alerts&lt;br&gt;Idempotencia: exec name, fp-inbox, event_id, batch_id&lt;br&gt;CloudWatch: alarmas DLQ &amp;gt; 0 · logs 14 d · incident_id" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF8E1;strokeColor=#F9A825;fontSize=10;fontColor=#37474F;align=left;spacingLeft=6;spacingTop=2;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1040" y="486" width="340" height="100" as="geometry"/></mxCell><mxCell id="c32" value="Cloud Storage fp-landing&lt;br&gt;us-east1 · lifecycle 3 d" style="html=1;fontSize=11;fontColor=#202124;verticalLabelPosition=bottom;verticalAlign=top;align=center;aspect=fixed;strokeColor=none;fillColor=#4285F4;shape=mxgraph.gcp2.cloud_storage;" vertex="1" parent="1"><mxGeometry x="90" y="850" width="56" height="56" as="geometry"/></mxCell><mxCell id="c33" value="BigQuery dataset fleetpulse&lt;br&gt;telemetry · domain_events&lt;br&gt;(particionadas) · vistas" style="html=1;fontSize=11;fontColor=#202124;verticalLabelPosition=bottom;verticalAlign=top;align=center;aspect=fixed;strokeColor=none;fillColor=#4285F4;shape=mxgraph.gcp2.bigquery;" vertex="1" parent="1"><mxGeometry x="250" y="850" width="56" height="56" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;BigQuery ML&lt;/b&gt;&lt;br&gt;m_peer_clusters (KMEANS)&lt;br&gt;m_fuel_trend (ARIMA_PLUS + DETECT_ANOMALIES)&lt;br&gt;m_parts_demand (ARIMA_PLUS, 14 d)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontColor=#202124;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="960" width="250" height="64" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Cloud Run insights&lt;/b&gt; (FastAPI)&lt;br&gt;/explain /peers /jobs /forecast&lt;br&gt;/kpis /anomalies /baselines&lt;br&gt;min 0 · max 2 · 512 MiB · sin LB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4285F4;fontColor=#202124;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="840" width="180" height="72" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;Gemini API&lt;/b&gt; (Flash)&lt;br&gt;JSON estructurado · T=0,2&lt;br&gt;1 llamada por incidente,&lt;br&gt;cacheada" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontColor=#202124;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="840" width="125" height="72" as="geometry"/></mxCell><mxCell id="c37" value="Secret Manager&lt;br&gt;gemini-api-key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#C5221F;fontColor=#202124;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="960" width="180" height="40" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Service accounts, mínimo privilegio&lt;/b&gt;&lt;br&gt;fp-exporter: objectCreator, jobUser, dataEditor&lt;br&gt;fp-invoker: run.invoker · fp-insights: dataViewer, jobUser&lt;br&gt;Guardas de costo: require_partition_filter, maximumBytesBilled 1 GB, cuota 30 GB/día, load jobs (nunca streaming)" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=10;fontColor=#37474F;align=left;spacingLeft=6;spacingTop=2;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="1040" width="560" height="56" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;Modo degradado:&lt;/b&gt; sin GCP, los incidentes se crean con explicación por plantilla. La IA nunca bloquea la asignación." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF8E1;strokeColor=#F9A825;fontSize=10;fontColor=#37474F;align=left;spacingLeft=6;spacingTop=2;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="640" y="960" width="150" height="136" as="geometry"/></mxCell><mxCell id="c40" value="ORDS módulo fleet/v1&lt;br&gt;OAuth2 client credentials&lt;br&gt;POST /events /machines/snapshot&lt;br&gt;/reorders /kpis · GET /incidents/:id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C74634;fontColor=#202124;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="870" y="834" width="200" height="84" as="geometry"/></mxCell><mxCell id="c41" value="Autonomous Database Serverless (ATP) fpdb&lt;br&gt;esquema FLEET · PL/SQL FLEET_EVENTS.apply&lt;br&gt;PROCESSED_EVENTS = inbox (event_id único)&lt;br&gt;PART_STOCK: reserva atómica (CHECK reserved ≤ on_hand)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3F1;strokeColor=#C74634;fontColor=#202124;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1095" y="834" width="275" height="84" as="geometry"/></mxCell><mxCell id="c42" value="APEX (consola)&lt;br&gt;mapa 100 máquinas · incidentes · ficha&lt;br&gt;por máquina · stock · KPIs · botón Cerrar&lt;br&gt;refresco 15 s · Web Credential → AWS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C74634;fontColor=#202124;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1395" y="834" width="190" height="84" as="geometry"/></mxCell><mxCell id="c43" value="Responsable de mantenimiento&lt;br&gt;y técnicos" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;strokeColor=#37474F;fillColor=#ECEFF1;" vertex="1" parent="1"><mxGeometry x="1480" y="970" width="36" height="60" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;Always Free, y cómo lo compensamos&lt;/b&gt;&lt;br&gt;Sin Data Guard ni backups manuales → OCI se reconstruye desde s3://fp-raw/events/ con replay-oci.py&lt;br&gt;20 sesiones máx. → escritura solo por ORDS (pool en servidor), nunca driver oracledb con wallet&lt;br&gt;La telemetría no entra a OCI: 20 GB alcanzan a 10.000 máquinas" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FDF3F1;strokeColor=#C74634;fontSize=10;fontColor=#37474F;align=left;spacingLeft=6;spacingTop=2;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="870" y="950" width="580" height="80" as="geometry"/></mxCell><mxCell id="c45" value="cron 1 min" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#546E7A;strokeWidth=1.5;fontSize=10;fontColor=#37474F;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c46" value="lote de 10 · API key" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#546E7A;strokeWidth=1.5;fontSize=10;fon