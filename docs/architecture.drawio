        <mxCell id="c2" value="FleetPulse · ArquiFusion Corp — Arquitectura de la solución" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#1A237E;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1000" height="30" as="geometry"/></mxCell><mxCell id="c3" value="AWS es el hub: recibe telemetría, decide y orquesta. OCI registra y opera. GCP aprende y explica. OCI y GCP nunca se llaman entre sí. 100 % serverless, capa gratuita." style="text;html=1;fontSize=11;fontColor=#455A64;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1200" height="22" as="geometry"/></mxCell><mxCell id="c4" value="AWS · us-east-1 (Learner Lab, LabRole) — Hub: ingesta, detección, orquestación, secretos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8F0;strokeColor=#FF9900;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#232F3E;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1560" height="600" as="geometry"/></mxCell><mxCell id="c5" value="GCP · us-east1 / BigQuery US (nivel gratuito) — Analítica histórica e IA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F6FE;strokeColor=#4285F4;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#1A237E;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="760" height="330" as="geometry"/></mxCell><mxCell id="c6" value="OCI · us-ashburn-1 (Always Free) — Sistema de registro y consola operativa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3F1;strokeColor=#C74634;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#7F2318;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;arcSize=3;" vertex="1" parent="1"><mxGeometry x="840" y="770" width="760" height="330" as="geometry"/></mxCell><mxCell id="c7" value="Lambda simulator&lt;br&gt;100 máquinas · cada 1 min&lt;br&gt;TIME_WARP=5" style="sketch=0;outlineConnect=0;fo