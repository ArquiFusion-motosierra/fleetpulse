        <mxCell id="c2" value="FleetPulse · ArquiFusion Corp — Arquitectura de la solución" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#1A237E;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1000" height="30" as="geometry"/></mxCell><mxCell id="c3" value="AWS es el hub: recibe telemetría, decide, orquesta y guarda el registro operativo. GCP aprende del histórico, explica con Gemini y sirve la consola. Dos nubes, 100 % serverless, capa gratuita." style="text;html=1;fontSize=11;fontColor=#455A64;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1300" height="22" as="geometry"/></mxCell><mxCell id="c4" value="AWS · us-east-1 (Learner Lab, LabRole) — Hub: ingesta, detección, orquestación, registro operativo, secretos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8F0;strokeColor=#FF9900;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#232F3E;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1560" height="600" as="geometry"/></mxCell><mxCell id="c5" value="GCP · us-east1 / BigQuery US (nivel gratuito) — Analítica histórica, IA y consola operativa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F6FE;strokeColor=#4285F4;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#1A237E;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="1560" height="330" as="geometry"/></mxCell><mxCell id="c6" value="Lambda simulator&lt;br&gt;100 máquinas · cada 1 min&lt;br&gt;TIME_WARP=5" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;fillColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="90" y="130" width="56" height="56" as="geometry"/></mxCell><mxCell id="c7" value="API Gateway HTTP&lt;br&gt;/telemetry · /approvals/{token}&lt;br&gt;/incidents/{id}/close · GET /machines…" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;fillColor=#E7157B;" vertex="1" parent="1"><mxGeometry x="260" y="130" width="56" height="56" as="geometry"/></mxCell><mxCell id="c8" value="Lambda ingest&lt;br&gt;valida contracts/&lt;br&gt;telemetry-batch" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;fillColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="430" y="130" width="56" height="56" as="geometry"/></mxCell><mxCell id="c9" value="DynamoDB fp-state&lt;br&gt;single-table · stream&lt;br&gt;PITR · TTL 3 d" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;fillColor=#C925D1;" vertex="1" parent="1"><mxGeometry x="600" y="130" width="56" height="56" as="geometry"/></mxCell><mxCell id="c10" value="Lambda score&lt;br&gt;z propio y z pares&lt;br&gt;score compuesto" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;fillColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="770" y="130" width="56" height="56" as="geometry"/></mxCell><mxCell id="c11" value="Step Functions STANDARD&lt;br&gt;incident-flow&lt;br&gt;exec = machine_id + ventana 15 min" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.step_functions;fillColor=#E7157B;" vertex="1" parent="1"><mxGeometry x="940" y="130" width="56" height="56" as="geometry"/></mxCell><mxCell id="c12" value="SNS fp-notify&lt;br&gt;filtro por atributo role" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;fillColor=#E7157B;" vertex="1" parent="1"><mxGeometry x="1120" y="130" width="56" height="56" as="geometry"/></mxCell><mxCell id="c13" value="Técnico · Supervisor&lt;br&gt;Dirección · Operador&lt;br&gt;(4 correos distintos)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;strokeColor=#37474F;fillColor=#ECEFF1;" vertex="1" parent="1"><mxGeometry x="1300" y="126" width="36" height="60" as="geometry"/></mxCell><mxCell id="c14" value="Responsable de&lt;br&gt;mantenimiento&lt;br&gt;(aprueba por correo)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;strokeColor=#37474F;fillColor=#ECEFF1;" vertex="1" parent="1"><mxGeometry x="1480" y="126" width="36" height="60" as="geometry"/></mxCell><mxCell id="c15" value="EventBridge (reglas cron)&lt;br&gt;simulator 1 min · exporter 1 h&lt;br&gt;planning 05:00" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge;fillColor=#E7157B;" vertex="1" parent="1"><mxGeometry x="90" y="310" width="56" height="56" as="geometry"/></mxCell><mxCell id="c16" value="S3 fp-raw (versionado)&lt;br&gt;telemetry/dt=/hr= · events/&lt;br&gt;Glacier IR a 90 d" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;fillColor=#7AA116;" vertex="1" parent="1"><mxGeometry x="260" y="310" width="56" height="56" as="geometry"/></mxCell><mxCell id="c17" value="Lambda archiver&lt;br&gt;NDJSON gzip&lt;br&gt;1.000 reg. o 5 min" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;fillColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="430" y="310" width="56" height="56" as="geometry"/></mxCell><mxCell id="c18" value="DynamoDB fp-registry&lt;br&gt;incidentes · stock por zona&lt;br&gt;reservas · órdenes · KPIs · PITR" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;fillColor=#C925D1;" vertex="1" parent="1"><mxGeometry x="770" y="310" width="56" height="56" as="geometry"/></mxCell><mxCell id="c19" value="DynamoDB fp-outbox&lt;br&gt;stream · TTL 7 d&lt;br&gt;+ fp-inbox" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;fillColor=#C925D1;" vertex="1" parent="1"><mxGeometry x="940" y="310" width="56" height="56" as="geometry"/></mxCell><mxCell id="c20" value="Lambda outbox-publisher" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;fillColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="1120" y="310" width="56" height="56" as="geometry"/></mxCell><mxCell id="c21" value="SNS fp-domain-events" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;fillColor=#E7157B;" vertex="1" parent="1"><mxGeometry x="1300" y="310" width="56" height="56" as="geometry"/></mxCell><mxCell id="c22" value="SQS registry-q&lt;br&gt;+ DLQ (5 intentos)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;fillColor=#E7157B;" vertex="1" parent="1"><mxGeometry x="1480" y="250" width="56" height="56" as="geometry"/></mxCell><mxCell id="c23" value="SQS gcp-events-q&lt;br&gt;+ DLQ" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;fillColor=#E7157B;" vertex="1" parent="1"><mxGeometry x="1480" y="370" width="56" height="56" as="geometry"/></mxCell><mxCell id="c24" value="Secrets Manager&lt;br&gt;gcp/sa-exporter · gcp/sa-invoker&lt;br&gt;api/ingest-key · api/console-key" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;fillColor=#DD344C;" vertex="1" parent="1"><mxGeometry x="90" y="490" width="56" height="56" as="geometry"/></mxCell><mxCell id="c25" value="Lambda gcp-exporter&lt;br&gt;cada hora · marca de agua&lt;br&gt;en fp-state" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;fillColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="260" y="490" width="56" height="56" as="geometry"/></mxCell><mxCell id="c26" value="Lambda gcp-events&lt;br&gt;archiva eventos en S3" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;fillColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="430" y="490" width="56" height="56" as="geometry"/></mxCell><mxCell id="c27" value="Step Functions STANDARD&lt;br&gt;daily-planning&lt;br&gt;05:00 Lima y bajo demanda" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.step_functions;fillColor=#E7157B;" vertex="1" parent="1"><mxGeometry x="600" y="490" width="56" height="56" as="geometry"/></mxCell><mxCell id="c28" value="Lambda query-api&lt;br&gt;GET /machines /incidents /stock&lt;br&gt;(lectura para la consola)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;fillColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="770" y="490" width="56" height="56" as="geometry"/></mxCell><mxCell id="c29" value="SSM Parameter Store&lt;br&gt;/fleetpulse/sim/scenarios&lt;br&gt;(perillas S1–S6)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.systems_manager;fillColor=#E7157B;" vertex="1" parent="1"><mxGeometry x="940" y="490" width="56" height="56" as="geometry"/></mxCell><mxCell id="c30" value="Lambda registry&lt;br&gt;reserva atómica&lt;br&gt;ConditionExpression" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;fillColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="1480" y="490" width="56" height="56" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Persistencia, HA y observabilidad&lt;/b&gt;&lt;br&gt;DynamoDB fp-state y fp-registry: 3 AZ, PITR 35 d, deletion protection&lt;br&gt;S3: 11 nueves, versionado; events/ reconstruye fp-registry&lt;br&gt;SQS multi-AZ + DLQ 14 d · SFN: backoff, Catch → fp-alerts&lt;br&gt;Idempotencia: exec name, fp-inbox, event_id, batch_id, ConditionExpression&lt;br&gt;CloudWatch: alarmas DLQ &amp;gt; 0 · logs 14 d · incident_id = ID de correlación" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF8E1;strokeColor=#F9A825;fontSize=10;fontColor=#37474F;align=left;spacingLeft=6;spacingTop=2;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1050" y="574" width="370" height="100" as="geometry"/></mxCell><mxCell id="c32" value="Cloud Storage fp-landing&lt;br&gt;us-east1 · lifecycle 3 d" style="html=1;fontSize=11;fontColor=#202124;verticalLabelPosition=bottom;verticalAlign=top;align=center;aspect=fixed;strokeColor=none;fillColor=#4285F4;shape=mxgraph.gcp2.cloud_storage;" vertex="1" parent="1"><mxGeometry x="90" y="850" width="56" height="56" as="geometry"/></mxCell><mxCell id="c33" value="BigQuery dataset fleetpulse&lt;br&gt;telemetry · domain_events&lt;br&gt;(particionadas) · vistas" style="html=1;fontSize=11;fontColor=#202124;verticalLabelPosition=bottom;verticalAlign=top;align=center;aspect=fixed;strokeColor=none;fillColor=#4285F4;shape=mxgraph.gcp2.bigquery;" vertex="1" parent="1"><mxGeometry x="250" y="850" width="56" height="56" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;BigQuery ML&lt;/b&gt;&lt;br&gt;m_peer_clusters (KMEANS)&lt;br&gt;m_fuel_trend (ARIMA_PLUS + DETECT_ANOMALIES)&lt;br&gt;m_parts_demand (ARIMA_PLUS, 14 d)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontColor=#202124;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="960" width="250" height="64" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Cloud Run insights&lt;/b&gt; (FastAPI, privado)&lt;br&gt;/explain /peers /jobs /forecast&lt;br&gt;/kpis /anomalies /baselines&lt;br&gt;min 0 · max 2 · 512 MiB · sin LB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4285F4;fontColor=#202124;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="840" width="190" height="72" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;Gemini API&lt;/b&gt; (Flash)&lt;br&gt;JSON estructurado · T=0,2&lt;br&gt;1 llamada por incidente,&lt;br&gt;cacheada" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontColor=#202124;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="840" width="125" height="72" as="geometry"/></mxCell><mxCell id="c37" value="Secret Manager&lt;br&gt;gemini-api-key · aws-console-api-key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#C5221F;fontColor=#202124;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="960" width="190" height="40" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Cloud Run console&lt;/b&gt; (React + MapLibre servido por FastAPI)&lt;br&gt;mapa 100 máquinas · incidentes con línea de tiempo&lt;br&gt;ficha por máquina · stock por zona · KPIs&lt;br&gt;botón Cerrar → AWS · refresco 15 s · min 0 · max 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4285F4;fontColor=#202124;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="840" width="290" height="72" as="geometry"/></mxCell><mxCell id="c39" value="Responsable de mantenimiento&lt;br&gt;y técnicos (navegador)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;strokeColor=#37474F;fillColor=#ECEFF1;" vertex="1" parent="1"><mxGeometry x="1300" y="844" width="36" height="60" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Service accounts, mínimo privilegio&lt;/b&gt;&lt;br&gt;fp-exporter: objectCreator, jobUser, dataEditor · fp-invoker: run.invoker&lt;br&gt;fp-insights: dataViewer, jobUser · fp-console: dataViewer, jobUser, run.invoker&lt;br&gt;Guardas de costo: require_partition_filter, maximumBytesBilled 1 GB, cuota 30 GB/día, load jobs (nunca streaming)" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=10;fontColor=#37474F;align=left;spacingLeft=6;spacingTop=2;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="1040" width="580" height="60" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;Modo degradado:&lt;/b&gt; sin GCP, los incidentes se crean con explicación por plantilla y los correos por rol siguen llegando. La IA nunca bloquea la asignación." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF8E1;strokeColor=#F9A825;fontSize=10;fontColor=#37474F;align=left;spacingLeft=6;spacingTop=2;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="670" y="960" width="220" height="70" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;Plan B aplicado (sáb 14/11):&lt;/b&gt; OCI (Autonomous DB + ORDS + APEX) era el sistema de registro y la consola. No se pudo activar la cuenta: el registro pasó a DynamoDB fp-registry y la consola a Cloud Run. Dos nubes cumplen la rúbrica." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FDF3F1;strokeColor=#C74634;fontSize=10;fontColor=#37474F;align=left;spacingLeft=6;spacingTop=2;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="900" y="960" width="290" height="80" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;Cómo se ve el mismo incident_id en las dos nubes&lt;/b&gt;&lt;br&gt;Step Functions (grafo de incident-flow) · Cloud Run insights (log de /explain) · BigQuery (domain_events) · Consola (ficha del incidente)" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=10;fontColor=#37474F;align=left;spacingLeft=6;spacingTop=2;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1210" y="960" width="370" height="80" as="geometry"/></mxCell><mxCell id="c44" value="cron 1 min" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#546E7A;strokeWidth=1.5;fontSize=10;fontColor=#37474F;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c45" value="lote de 10 · API key" style="edgeStyle=orthogonalEdgeStyle;rounded=1;